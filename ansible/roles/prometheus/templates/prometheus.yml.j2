# Managed by Ansible (role: prometheus)
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: node
    static_configs:
{% for host in groups['lab'] %}
      - targets: ["{{ hostvars[host]['ansible_host'] }}:9100"]
        labels:
          host: "{{ host }}"
{% endfor %}

  - job_name: blackbox_icmp
    metrics_path: /probe
    scrape_interval: 30s
    params:
      module: [icmp]
    static_configs:
{% for host in groups['lab'] %}
      - targets: ["{{ hostvars[host]['ansible_host'] }}"]
        labels:
          host: "{{ host }}"
{% endfor %}
{% for t in prometheus_probe_icmp_targets %}
      - targets: ["{{ t.address }}"]
        labels:
          host: "{{ t.name }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "localhost:9115"

  - job_name: blackbox_http
    metrics_path: /probe
    scrape_interval: 30s
    params:
      module: [http_2xx]
    static_configs:
{% for t in prometheus_probe_http_targets %}
      - targets: ["{{ t.url }}"]
        labels:
          service: "{{ t.name }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "localhost:9115"

  - job_name: blackbox_http_external
    metrics_path: /probe
    scrape_interval: 60s
    params:
      module: [http_head_2xx]
    static_configs:
{% for t in prometheus_probe_http_external_targets %}
      - targets: ["{{ t.url }}"]
        labels:
          service: "{{ t.name }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "localhost:9115"

  - job_name: blackbox_dns
    metrics_path: /probe
    scrape_interval: 30s
    params:
      module: [dns_a]
    static_configs:
{% for t in prometheus_probe_dns_targets %}
      - targets: ["{{ t.address }}"]
        labels:
          server: "{{ t.name }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "localhost:9115"

  - job_name: blackbox_dns_local
    metrics_path: /probe
    scrape_interval: 30s
    params:
      module: [dns_local]
    static_configs:
{% for t in prometheus_probe_dns_local_targets %}
      - targets: ["{{ t.address }}"]
        labels:
          server: "{{ t.name }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "localhost:9115"

  - job_name: alertmanager
    static_configs:
      - targets: ["localhost:9093"]

rule_files:
  - /etc/prometheus/alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["localhost:9093"]
